{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npx --yes pnpm@11.21.0 install --frozen-lockfile",
  "buildCommand": "npx --yes pnpm@11.21.0 run build",
  "outputDirectory": "dist",
  "routes": [
    {
      "src": "^/(api(?:/.*)?|health|health/ready)$",
      "dest": "${PULSEDESK_API_ORIGIN}/$1",
      "env": ["PULSEDESK_API_ORIGIN"],
      "headers": { "x-vercel-enable-rewrite-caching": "0" },
      "transforms": [
        {
          "type": "request.headers",
          "op": "set",
          "target": { "key": "x-pulsedesk-proxy-secret" },
          "args": "${PROXY_SHARED_SECRET}",
          "env": ["PROXY_SHARED_SECRET"]
        }
      ]
    }
  ],
  "rewrites": [{ "source": "/((?!api/|api$|health$).*)", "destination": "/index.html" }],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'sha256-2xnBknYKUnkGkxKiv7su3rt2iWjgoeIZEhX/pdy1saA='; style-src 'self' 'unsafe-inline'; img-src 'self'; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"
        },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000" },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
        { "key": "Cross-Origin-Resource-Policy", "value": "same-origin" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ]
}
