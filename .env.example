# ─────────────────────────────────────────────────────────────────────────────
# PulseDesk environment template.
# Copy to `.env` (repo root) and adjust. Never commit `.env`. All values below are
# local-development placeholders, not real credentials.
#
# [used]      read by the code today; the API validates these at startup and
#             refuses to boot if any are invalid.
# [reserved]  documented now, read once the feature that needs it lands.
# ─────────────────────────────────────────────────────────────────────────────

# --- Runtime -----------------------------------------------------------------
# [used] development | test | production. Defaults to development for the API.
# Leave it unset here: Vite reads this file too, and NODE_ENV in an env file would make
# `pnpm build` produce a development bundle. Set it in the process environment instead.
# NODE_ENV=development
# [used] fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=debug
# [used] Reported by GET /health. CI/deploys can set this to a release or commit SHA.
APP_VERSION=0.0.0-dev

# --- API server --------------------------------------------------------------
# [used] Bind address. Keep 127.0.0.1 locally; use 0.0.0.0 inside containers.
API_HOST=127.0.0.1
# [used]
API_PORT=4000
# [used] Public origin of the web app. Used for the CORS allowlist, the Origin
# (CSRF) check on state-changing requests, and later the Socket.IO handshake.
# Comma-separate multiple. Must be https:// when NODE_ENV=production.
WEB_ORIGIN=http://localhost:5173
# [used] Number of reverse proxies in front of the API (0 locally). Controls Express
# "trust proxy" so client IPs used for rate limiting and audit logs are accurate.
TRUST_PROXY_HOPS=0
# [used] How long in-flight requests get to finish on SIGTERM/SIGINT.
SHUTDOWN_TIMEOUT_MS=10000

# --- Database (PostgreSQL) ---------------------------------------------------
# [used by packages/db: migrations, seed, Prisma Studio]
# Works with a native PostgreSQL install or the optional docker-compose.yml.
DATABASE_URL=postgresql://pulsedesk:pulsedesk_dev_password@localhost:5432/pulsedesk
# [used by `pnpm test:integration`] Separate database; it is wiped on every run.
TEST_DATABASE_URL=postgresql://pulsedesk:pulsedesk_dev_password@localhost:5432/pulsedesk_test

# --- Redis-compatible server (Redis, Valkey, Memurai) ------------------------
# [reserved — background jobs, shared rate limits, Socket.IO adapter]
REDIS_URL=redis://localhost:6379

# --- Sessions ----------------------------------------------------------------
# [reserved — Phase 3 authentication]
# Secret used to HMAC session tokens before lookup. Generate your own:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Must be at least 32 characters. The placeholder below will be rejected outside development.
SESSION_SECRET=replace-me-with-a-random-32-plus-character-value
# Cookie name. In production use the __Host- prefix (requires HTTPS):
#   SESSION_COOKIE_NAME=__Host-pd_sid
SESSION_COOKIE_NAME=pd_sid
# Sets the Secure cookie flag. Must be true in production.
SESSION_COOKIE_SECURE=false
# Session ends after this much inactivity (minutes).
SESSION_IDLE_TIMEOUT_MINUTES=720
# Hard upper bound on a session's lifetime regardless of activity (days).
SESSION_ABSOLUTE_TIMEOUT_DAYS=14

# --- Rate limiting -----------------------------------------------------------
# [used] Requests per minute per client IP for /api/* (GET /health is exempt).
RATE_LIMIT_GLOBAL_PER_MINUTE=300
# [reserved — Phase 3] Login / password-reset attempts per 15 minutes.
RATE_LIMIT_AUTH_PER_15_MINUTES=10

# --- Web app ------------------------------------------------------------------
# Vite exposes only VITE_-prefixed variables to the browser. Never put secrets in them.
# [used, optional] Where the Vite dev/preview server proxies /api and /health.
# Read by vite.config.ts on the Node side only — never exposed to the browser.
# API_PROXY_TARGET=http://127.0.0.1:4000
