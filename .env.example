# ─────────────────────────────────────────────────────────────────────────────
# PulseDesk environment template.
# Copy to `.env` (repo root) and adjust. Never commit `.env`. All values below are
# local-development placeholders, not real credentials.
#
# [used]      read by the code today; the API validates these at startup and
#             refuses to boot if any are invalid.
# [reserved]  documented now, read once the feature that needs it lands.
# ─────────────────────────────────────────────────────────────────────────────

# --- Runtime -----------------------------------------------------------------
# [used] development | test | production. Defaults to development for the API.
# Leave it unset here: Vite reads this file too, and NODE_ENV in an env file would make
# `pnpm build` produce a development bundle. Set it in the process environment instead.
# NODE_ENV=development
# [used] fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=debug
# [used] Reported by GET /health. CI/deploys can set this to a release or commit SHA.
APP_VERSION=0.0.0-dev

# --- API server --------------------------------------------------------------
# [used] Bind address. Keep 127.0.0.1 locally; use 0.0.0.0 inside containers.
API_HOST=127.0.0.1
# [used]
API_PORT=4000
# [used] Public origin of the web app. Used for the CORS allowlist, the Origin
# (CSRF) check on state-changing requests, and later the Socket.IO handshake.
# Comma-separate multiple. Must be https:// when NODE_ENV=production.
WEB_ORIGIN=http://localhost:5173
# [used] Shared secret the reverse proxy (Vercel in production) sends on every request it
# forwards, in the X-PulseDesk-Proxy-Secret header. When set, the API rejects everything
# except GET /health that lacks it (generic 403). REQUIRED when NODE_ENV=production; leave
# it unset locally, or set it to test enforcement — the Vite dev/preview proxy then sends it
# too (Node side only, never in the browser bundle). 32+ chars of [A-Za-z0-9_-], distinct
# from SESSION_SECRET:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# PROXY_SHARED_SECRET=
# [used] Number of reverse proxies in front of the API (0 locally). Controls Express
# "trust proxy" so client IPs used for rate limiting and audit logs are accurate.
TRUST_PROXY_HOPS=0
# [used] How long in-flight requests get to finish on SIGTERM/SIGINT.
SHUTDOWN_TIMEOUT_MS=10000
# [used] How often (seconds, 0–3600) the API records SLA breaches; 0 turns the sweep off.
# It never runs when NODE_ENV=test. Assumes a single API instance (docs/deployment.md).
SLA_SWEEP_INTERVAL_SECONDS=60
# [used] Tickets per sweep batch (1–1000); a run reads at most 10 batches per SLA target.
SLA_SWEEP_BATCH_SIZE=100
# [used] How often (seconds, 0–3600) the API auto-closes quiet solved tickets for organizations
# that turned auto-close on; 0 turns it off. Never runs when NODE_ENV=test.
AUTO_CLOSE_SWEEP_INTERVAL_SECONDS=300
# [used] Tickets per auto-close batch (1–1000); a run reads at most 10 batches.
AUTO_CLOSE_BATCH_SIZE=100

# --- Database (PostgreSQL) ---------------------------------------------------
# [used] Required by the API (sessions, organizations) and by packages/db (migrations,
# seed, Prisma Studio). Works with a native PostgreSQL install or the optional
# docker-compose.yml. In production, set it in the platform's secret store, never in a file.
DATABASE_URL=postgresql://pulsedesk:pulsedesk_dev_password@localhost:5432/pulsedesk
# [used by `pnpm test:integration` and `pnpm test:e2e`] Separate, disposable database:
# integration tests wipe it on every run and E2E tests sign up throwaway users in it.
TEST_DATABASE_URL=postgresql://pulsedesk:pulsedesk_dev_password@localhost:5432/pulsedesk_test

# --- Redis-compatible server (Redis, Valkey, Memurai) ------------------------
# [reserved — background jobs, shared rate limits, Socket.IO adapter]
REDIS_URL=redis://localhost:6379

# --- Sessions ----------------------------------------------------------------
# [used] Secret used to HMAC session tokens before lookup (only the HMAC is stored).
# Generate your own:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Must be at least 32 characters. The placeholder below is accepted only when
# NODE_ENV=development; the API refuses to start with it in test or production.
# Rotating it signs every user out.
SESSION_SECRET=replace-me-with-a-random-32-plus-character-value
# [used] Cookie name. Production requires the __Host- prefix (HTTPS, host-only, Path=/):
#   SESSION_COOKIE_NAME=__Host-pd_sid
SESSION_COOKIE_NAME=pd_sid
# [used] Sets the Secure cookie flag. Must be true in production (and with __Host- names).
SESSION_COOKIE_SECURE=false
# [used] Session ends after this much inactivity (minutes).
SESSION_IDLE_TIMEOUT_MINUTES=720
# [used] Hard upper bound on a session's lifetime regardless of activity (days).
SESSION_ABSOLUTE_TIMEOUT_DAYS=14

# --- Rate limiting -----------------------------------------------------------
# [used] Requests per minute per client IP for /api/* (GET /health is exempt).
RATE_LIMIT_GLOBAL_PER_MINUTE=300
# [used] Failed sign-ins per 15 minutes, counted per client IP and per target email;
# also caps registrations per client IP.
RATE_LIMIT_AUTH_PER_15_MINUTES=10

# --- Web app ------------------------------------------------------------------
# Vite exposes only VITE_-prefixed variables to the browser. Never put secrets in them.
# The web app currently reads no VITE_ variables; a Vercel deployment needs none (docs/deployment.md).
# [used, optional] Where the Vite dev/preview server proxies /api and /health.
# Read by vite.config.ts on the Node side only — never exposed to the browser.
# API_PROXY_TARGET=http://127.0.0.1:4000
